# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=your_mongodb_connection_string

# Secret used to sign login session tokens (any long random string)
JWT_SECRET=your_secret_key_here

# Merchant payment recipient settings (Indian UPI VPA)
NEXT_PUBLIC_MERCHANT_UPI_ID=your_upi_id@bank
NEXT_PUBLIC_MERCHANT_NAME=Courts After Dark

# Real SMS Gateway for Physical Mobile Phone Delivery (Optional)
# Get free Indian SMS credits at https://www.fast2sms.com
FAST2SMS_API_KEY=your_fast2sms_api_key_here
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_PHONE_NUMBER=+1234567890



